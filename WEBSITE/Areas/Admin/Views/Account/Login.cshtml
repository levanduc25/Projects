@using WEBSITE.Models.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Shared/_LayoutLogin.cshtml";
}

<div class="login-container">
    <div class="row vh-100 d-flex justify-content-center align-items-center">
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-body px-4 py-5">
                    <h2 class="card-title text-center mb-3">Login to Account</h2>
                    <p class="text-muted text-center mb-4">Please enter your username and password to continue</p>
                    <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post">

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Username:</label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <label asp-for="Password" class="form-label mb-0">Password:</label>
                                <a href="#" class="text-decoration-none text-primary">Forgot Password?</a>
                            </div>
                            <input asp-for="Password" class="form-control" type="password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe">
                                <label class="form-check-label" for="rememberMe">
                                    Remember Password
                                </label>
                            </div>

                        </div>
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">Sign in</button>
                        </div>

                        <div asp-validation-summary="All" class="text-danger text-center mb-3"></div>

                        <p class="text-center pt-2">Don't have an account? <a
                                href="@Url.Action("Register", "Account", new { area = "Admin" })">Create Account?</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>