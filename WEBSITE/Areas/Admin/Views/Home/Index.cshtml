@model IEnumerable<WEBSITE.Models.ViewModels.DealViewModel>
@{
    ViewData["Title"] = "Home";
    Layout = "~/Shared/_LayoutAdmin.cshtml";

    // Ép kiểu an toàn từ ViewBag
    double userPercentChange = ViewBag.UserPercentChange != null ? Convert.ToDouble(ViewBag.UserPercentChange) : 0;
    double orderPercentChange = ViewBag.OrderPercentChange != null ? Convert.ToDouble(ViewBag.OrderPercentChange) : 0;
    double salesPercentChange = ViewBag.SalesPercentChange != null ? Convert.ToDouble(ViewBag.SalesPercentChange) : 0;
    double pendingPercentChange = ViewBag.PendingPercentChange != null ? Convert.ToDouble(ViewBag.PendingPercentChange) : 0;
}

<div class="container-fluid min-vh-100 d-flex flex-column">
    <h3 class="mb-4">Dashboard</h3>

    <!-- Hàng 1: Thống kê -->
    <div class="row g-3">
        <!-- Total Users -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-3 bg-light">
                            <i class="fa-solid fa-user fa-lg text-primary"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Total Users</h6>
                            <h4 class="fw-bold mb-0">@((ViewBag.TotalUser ?? 0).ToString("N0"))</h4>
                            @if (userPercentChange > 0)
                            {
                                <small class="text-success">
                                    <i class="fa-solid fa-arrow-trend-up"></i>
                                    @String.Format("{0:0.0}%", Math.Abs(userPercentChange)) Up from yesterday
                                </small>
                            }
                            else if (userPercentChange == 0)
                            {
                                <small class="text-secondary">
                                    <i class="fa-solid fa-minus"></i>
                                    Same as yesterday
                                </small>
                            }
                            else
                            {
                                <small class="text-danger">
                                    <i class="fa-solid fa-arrow-trend-down"></i>
                                    @String.Format("{0:0.0}%", Math.Abs(userPercentChange)) Down from yesterday
                                </small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Orders -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-3 bg-light">
                            <i class="fa-solid fa-cart-shopping fa-lg text-warning"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Total Orders</h6>
                            <h4 class="fw-bold mb-0">@((ViewBag.TotalOrder ?? 0).ToString("N0"))</h4>
                            @if (orderPercentChange > 0)
                            {
                                <small class="text-success">
                                    <i class="fa-solid fa-arrow-trend-up"></i>
                                    @String.Format("{0:0.0}%", Math.Abs(orderPercentChange)) Up from yesterday
                                </small>
                            }
                            else if (orderPercentChange == 0)
                            {
                                <small class="text-secondary">
                                    <i class="fa-solid fa-minus"></i>
                                    Same as yesterday
                                </small>
                            }
                            else
                            {
                                <small class="text-danger">
                                    <i class="fa-solid fa-arrow-trend-down"></i>
                                    @String.Format("{0:0.0}%", Math.Abs(orderPercentChange)) Down from yesterday
                                </small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Sales -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-3 bg-light">
                            <i class="fa-solid fa-dollar-sign fa-lg text-success"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Total Sales</h6>
                            <h4 class="fw-bold mb-0">@String.Format("{0:C}", ViewBag.TotalSales ?? 0)</h4>
                            @if (salesPercentChange > 0)
                            {
                                <small class="text-success">
                                    <i class="fa-solid fa-arrow-trend-up"></i>
                                    @String.Format("{0:0.0}%", Math.Abs(salesPercentChange)) Up from yesterday
                                </small>
                            }
                            else if (salesPercentChange == 0)
                            {
                                <small class="text-secondary">
                                    <i class="fa-solid fa-minus"></i>
                                    Same as yesterday
                                </small>
                            }
                            else
                            {
                                <small class="text-danger">
                                    <i class="fa-solid fa-arrow-trend-down"></i>
                                    @String.Format("{0:0.0}%", Math.Abs(salesPercentChange)) Down from yesterday
                                </small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Orders -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-3 bg-light">
                            <i class="fa-solid fa-clock fa-lg text-danger"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="text-muted mb-1">Pending Orders</h6>
                            <h4 class="fw-bold mb-0">@((ViewBag.TotalPending ?? 0).ToString("N0"))</h4>
                            @if (pendingPercentChange > 0)
                            {
                                <small class="text-success">
                                    <i class="fa-solid fa-arrow-trend-up"></i>
                                    @String.Format("{0:0.0}%", Math.Abs(pendingPercentChange)) Up from yesterday
                                </small>
                            }
                            else if (pendingPercentChange == 0)
                            {
                                <small class="text-secondary">
                                    <i class="fa-solid fa-minus"></i>
                                    Same as yesterday
                                </small>
                            }
                            else
                            {
                                <small class="text-danger">
                                    <i class="fa-solid fa-arrow-trend-down"></i>
                                    @String.Format("{0:0.0}%", Math.Abs(pendingPercentChange)) Down from yesterday
                                </small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng 2: Biểu đồ -->
    <div class="card mt-4 shadow-sm border-0 flex-grow-1">
        <div class="card-body d-flex justify-content-center align-items-center position-relative" style="min-height:300px;">
            <canvas id="saleChart" width="600" height="250"></canvas>
            <p id="noDataMessage" class="text-muted fs-5 position-absolute" style="display:none;">
                No data
            </p>
        </div>
    </div>

    <!-- Hàng 3: Deals Details -->
    <div class="card shadow-sm p-3 mt-4 bg-white rounded-3 mb-0">
        <h3 class="mb-3">Deals Details</h3>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Product</th>
                        <th>Location</th>
                        <th>Date - Time</th>
                        <th>Piece</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null)
                    {
                        <tr>
                            <td colspan="7" class="text-danger text-center">No Data</td>
                        </tr>
                    }
                    else if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-warning text-center">Data is Empty</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var deal in Model)
                        {
                            <tr>
                                <td>@deal?.Fullname</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@deal?.ProductImage" alt="@deal?.ProductName" width="40"
                                             class="rounded-circle me-2 border" />
                                        <span>@deal?.ProductName</span>
                                    </div>
                                </td>
                                <td>@deal?.Location</td>
                                <td>@deal?.DateTime.ToString("dd.MM.yyyy - hh:mm tt")</td>
                                <td>@deal?.Piece</td>
                                <td>$@deal?.Amount.ToString("N0")</td>
                                <td>@deal?.Status</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
